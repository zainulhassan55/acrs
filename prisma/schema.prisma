generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  message   String
  createdAt DateTime @default(now())
}

model MembershipApplication {
  id           String   @id @default(cuid())
  name         String
  email        String
  affiliation  String
  category     String
  createdAt    DateTime @default(now())
}
